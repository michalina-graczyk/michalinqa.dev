---
import consultationImage from "@assets/images/consultation.png";
import audytJakosciImage from "@assets/images/audyt-jakosci.jpg";
import szkolenieAiImage from "@assets/images/szkolenie-ai-w-qa.jpg";
import fallbackImage from "@assets/images/hero.png";

import { Image } from "astro:assets";
import Tags from "@components/ui/Tags.astro";

interface Props {
  url?: string;
  alt?: string;
  /**
   * Stable identifier used to look up the card image. Keying off `slug`
   * (frontmatter file name) instead of `title` means renaming the offer's
   * visible title doesn't silently break the image. An offer with no entry
   * in `imageMap` falls back to the hero illustration, so check the card
   * after adding one — the build stays green either way.
   */
  slug?: string;
  title?: string;
  description: string;
  tags: string[];
  mode?: "booking" | "waitlist";
  /**
   * Tailwind classes for the outer wrapper. Defaults to a 1/3-width column
   * sized for a 3-card row. Override when a parent layout needs the card to
   * fill a different slot (e.g. single-offer hero composition in `Offers.astro`).
   */
  wrapperClass?: string;
  /**
   * Heading level for the card title. Defaults to `h3`. Pass `h4` when the
   * card sits under a group heading (see the audience groups in
   * `Offers.astro`) so the document outline stays in order.
   */
  titleTag?: "h3" | "h4";
  /**
   * `vertical` stacks image over text — the grid default. `horizontal` puts the
   * image beside the text so a lone card can hold a full-width row instead of
   * shrinking into a corner (see the single-offer audience group in
   * `Offers.astro`). Falls back to stacked below `sm`.
   */
  orientation?: "vertical" | "horizontal";
}

interface ImageMap {
  [key: string]: ImageMetadata;
}

// Keyed by content collection slug (filename without `.md`). When you add
// a new offer file, also add its image here.
const imageMap: ImageMap = {
  konsultacje: consultationImage,
  "audyt-jakosci": audytJakosciImage,
  "szkolenie-ai-w-qa": szkolenieAiImage,
};

const {
  url = "#",
  alt = "Project",
  slug,
  description = "Project Description",
  title = "Project title",
  tags = ["Tags"],
  mode = "booking",
  wrapperClass = "w-full p-4 lg:w-1/3 flex flex-col",
  titleTag = "h3",
  orientation = "vertical",
} = Astro.props;

const image = (slug && imageMap[slug]) ?? fallbackImage;
const Title = titleTag;
const isHorizontal = orientation === "horizontal";
---

<section class={wrapperClass}>
  <article
    data-testid="card"
    class="flex flex-1 flex-col rounded-xl bg-white dark:bg-gray-800 p-3 shadow-lg dark:shadow-orange/20 transition-all duration-200 ease-in-out hover:scale-105 hover:shadow-xl hover:shadow-orange/10 dark:hover:shadow-orange/30 motion-reduce:transition-none motion-reduce:hover:scale-100"
  >
    <a
      href={url}
      aria-label={title ? `Zobacz ofertę: ${title}` : "Zobacz szczegóły oferty"}
      class:list={[
        "flex h-full flex-col",
        isHorizontal && "sm:flex-row sm:items-stretch sm:gap-2",
      ]}
    >
      <div
        class:list={[
          "relative flex items-end justify-center overflow-hidden rounded-xl",
          isHorizontal && "sm:w-2/5 sm:shrink-0",
        ]}
      >
        <!-- 4:3 crop, done by the image pipeline rather than CSS: the offer
             illustrations are square, and at the two-column card width an
             uncropped square turns the card into a poster. `position: top`
             keeps the subject in frame and drops the empty bottom of the
             artwork. -->
        <Image
          src={image}
          alt={alt}
          layout="constrained"
          width={500}
          height={375}
          fit="cover"
          position="top"
          loading="lazy"
          class="w-full"
        />
      </div>
      <div
        class:list={[
          "mt-1 flex flex-grow flex-col p-2",
          isHorizontal && "sm:mt-0 sm:justify-center",
        ]}
      >
        <Title class="text-xl text-orange lg:text-2xl">{title}</Title>
        <p
          class:list={[
            "text-s text-black dark:text-white",
            // Stacked cards need the description to push the tag row to the
            // bottom edge so a grid of cards keeps its tags aligned. Beside
            // the image there is no row to align to, so the text block just
            // centres as one unit instead of stretching.
            isHorizontal ? "flex-grow sm:mb-3 sm:flex-grow-0" : "flex-grow",
          ]}
        >
          {description}
        </p>
        <Tags tags={tags} mode={mode} />
      </div>
    </a>
  </article>
</section>
