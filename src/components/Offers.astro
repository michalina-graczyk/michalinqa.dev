---
import Card from "@components/ui/Card.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import { getCollection } from "astro:content";

// Waitlist offers always sort last. A sold-out card wedged between two
// bookable ones reads as a hole in the row rather than a deliberate state.
const allOffers = (await getCollection("offers")).sort(
  (a, b) =>
    Number(a.data.mode === "waitlist") - Number(b.data.mode === "waitlist"),
);

// The lineup speaks to two different buyers: a company with a budget, and a
// person paying for their own career. Grouping by `audience` lets a visitor
// self-select from the group label instead of reading every card to find the
// one that applies to them. Empty groups drop out, so the section still works
// when only one audience has live offers.
const groupDefinitions = [
  {
    audience: "team" as const,
    heading: "Dla zespołów i firm",
    lead: "Praca z organizacją: audyt procesu jakości i szkolenia dla zespołu. Rozliczenie B2B, praca w Waszym środowisku.",
  },
  {
    audience: "individual" as const,
    heading: "Dla osób indywidualnych",
    lead: "Praca 1:1 nad Twoją karierą, architekturą testów i codziennym wykorzystaniem AI.",
  },
];

const groups = groupDefinitions
  .map((group) => ({
    ...group,
    offers: allOffers.filter((offer) => offer.data.audience === group.audience),
  }))
  .filter((group) => group.offers.length > 0);
---

<section
  data-testid="offers"
  id="offers"
  class="mb-10 flex flex-col items-center justify-center bg-gray-50 py-16 dark:bg-gray-950 lg:mb-0 lg:py-24"
>
  <SectionTitle>Oferta</SectionTitle>

  <div class="mx-auto w-full max-w-6xl px-4">
    <p
      class="mx-auto mb-12 max-w-prose text-center text-lg leading-relaxed text-black dark:text-white"
    >
      Pomagam układać jakość w zespołach, które rosną szybciej niż ich proces
      testowania - i towarzyszę inżynierom, którzy chcą świadomie poruszać się w
      QA napędzanym przez AI. Jeśli żaden z formatów nie pasuje, materiały
      publikuję na{" "}
      <a href="/blog" class="text-orange underline-offset-4 hover:underline">
        blogu
      </a>{" "}
      oraz w{" "}
      <a href="#contact" class="text-orange underline-offset-4 hover:underline"
        >newsletterze</a
      >.
    </p>

    {
      groups.map((group) => (
        <div
          class="mb-14 last:mb-0"
          data-testid={`offers-group-${group.audience}`}
        >
          <h3 class="font-monospace text-xl text-black lg:text-2xl dark:text-white">
            {group.heading}
          </h3>
          <div class="mt-2 mb-6 h-1 w-10 bg-orange" />
          <p class="mb-8 max-w-prose text-gray-600 dark:text-gray-400">
            {group.lead}
          </p>

          <div
            class:list={[
              "grid gap-6",
              group.offers.length > 1
                ? "sm:grid-cols-2"
                : "max-w-md justify-self-start",
            ]}
          >
            {group.offers.map((offer) => (
              <Card
                url={`/offers/${offer.id}`}
                slug={offer.id}
                title={offer.data.title}
                description={offer.data.description}
                alt={offer.data.img_alt}
                tags={offer.data.tags}
                mode={offer.data.mode}
                titleTag="h4"
                wrapperClass="flex w-full flex-col"
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
